{
    "net_params": {
        "conv1d_strides": 12,
        "conv1d_filters": 16,
        "hidden_units": 36,
        "input_size": 1,
        "output_size": 1,
        "block_type": "LSTM"
    },
    "loss": {
        "val_loss": "MSE",
        "mask_first": 4096,
        "pre_emph_weight": 1.0,
        "pre_emph_coef": 0.85
    },
    "optimizer": {
        "lr": 0.01
    },
    "lr_scheduler": {
        "class": "ExponentialLR",
        "kwargs": {
            "gamma": 0.995
        }
    }
}
